# Local demo service. The server always binds to 127.0.0.1.
SHADOWSHIELD_PORT=8787
SHADOWSHIELD_DATABASE=~/.shadowshield/shadowshield.sqlite3
SHADOWSHIELD_OWNER_ID=local-owner
SHADOWSHIELD_SESSION_TTL_SECONDS=14400
SHADOWSHIELD_DASHBOARD_DIST=apps/dashboard/dist

# Optional development dashboard origin. Only this exact origin is accepted.
# SHADOWSHIELD_CORS_ORIGINS=http://127.0.0.1:5173
