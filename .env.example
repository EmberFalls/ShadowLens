# Local demo defaults. For a remote owner service, use an HTTPS reverse proxy;
# set PUBLIC_ORIGIN to the exact external origin and leave bind host on loopback.
SHADOWSHIELD_BIND_HOST=127.0.0.1
SHADOWSHIELD_PORT=8787
SHADOWSHIELD_DATABASE=~/.shadowshield/shadowshield.sqlite3
SHADOWSHIELD_OWNER_ID=local-owner
SHADOWSHIELD_SESSION_TTL_SECONDS=14400
SHADOWSHIELD_DASHBOARD_DIST=apps/dashboard/dist
# Keep this signing key with the owner service and include it in a protected
# backup. If unset, it is stored next to SHADOWSHIELD_DATABASE.
# SHADOWSHIELD_POLICY_SIGNING_KEY=~/.shadowshield/policy-signing-key.pem
# SHADOWSHIELD_PUBLIC_ORIGIN=https://shadowlens.example.com
# Comma-separated exact proxy IPs/CIDRs allowed to supply X-Forwarded-Proto/For.
# Keep this narrow; do not use 0.0.0.0/0 or ::/0.
# SHADOWSHIELD_TRUSTED_PROXY_IPS=127.0.0.1
# Only use this when the reverse proxy requires the API to listen on all interfaces:
# SHADOWSHIELD_BIND_HOST=0.0.0.0

# Optional development dashboard origin. Only this exact origin is accepted.
# SHADOWSHIELD_CORS_ORIGINS=http://127.0.0.1:5173
