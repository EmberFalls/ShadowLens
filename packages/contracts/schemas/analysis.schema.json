{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shadowshield.local/contracts/v2/analysis.schema.json",
  "title": "Local analysis output v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion",
    "engineVersion",
    "inputLength",
    "findings",
    "categoryCounts",
    "highestFindingSeverity",
    "aggregateScore",
    "aggregateTier",
    "scanCompleteness"
  ],
  "properties": {
    "contractVersion": {
      "const": "v2"
    },
    "engineVersion": {
      "type": "string",
      "minLength": 1
    },
    "inputLength": {
      "type": "integer",
      "minimum": 0,
      "maximum": 250000
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/finding"
      },
      "maxItems": 10000
    },
    "categoryCounts": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/category" },
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "highestFindingSeverity": {
      "enum": [
        "LOW",
        "MEDIUM",
        "HIGH",
        "CRITICAL",
        null
      ]
    },
    "aggregateScore": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "aggregateTier": {
      "enum": [
        "NONE",
        "LOW",
        "MEDIUM",
        "HIGH",
        "CRITICAL"
      ]
    },
    "scanCompleteness": {
      "const": "FULL"
    }
  },
  "$defs": {
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "ruleId",
        "category",
        "severity",
        "start",
        "end",
        "confidenceHint",
        "replaceable",
        "explanationCode"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "ruleId": {
          "enum": ["PII.EMAIL", "PII.INDIA_MOBILE", "PII.PAYMENT_CARD", "PII.AADHAAR", "PII.INDIA_PAN", "PII.GSTIN", "PII.IFSC", "PII.UPI", "SECRET.TOKEN", "SECRET.PEM_PRIVATE_KEY", "CONFIDENTIAL.MARKER", "CODE.STRUCTURE", "CONFIDENTIAL.CUSTOM_TERM", "PII.BULK_CONTACT_LIST"]
        },
        "category": {
          "$ref": "#/$defs/category"
        },
        "severity": {
          "$ref": "#/$defs/severity"
        },
        "start": {
          "type": "integer",
          "minimum": 0
        },
        "end": {
          "type": "integer",
          "minimum": 1
        },
        "confidenceHint": {
          "enum": [
            "LOW",
            "MEDIUM",
            "HIGH"
          ]
        },
        "replaceable": {
          "type": "boolean"
        },
        "explanationCode": {
          "enum": [
            "EXPLAIN_CONTACT_EMAIL",
            "EXPLAIN_CONTACT_PHONE",
            "EXPLAIN_PAYMENT_CARD",
            "EXPLAIN_AADHAAR",
            "EXPLAIN_INDIA_PAN",
            "EXPLAIN_GSTIN",
            "EXPLAIN_IFSC",
            "EXPLAIN_UPI",
            "EXPLAIN_PROVIDER_TOKEN",
            "EXPLAIN_PRIVATE_KEY",
            "EXPLAIN_CONFIDENTIAL_MARKER",
            "EXPLAIN_SOURCE_CODE",
            "EXPLAIN_BULK_CONTACT_LIST",
            "EXPLAIN_CUSTOM_PROTECTED_TERM"
          ]
        }
      }
    },
    "category": {
      "enum": [
        "PII_EMAIL",
        "PII_PHONE",
        "PII_PAYMENT_CARD",
        "PII_AADHAAR",
        "PII_INDIA_PAN",
        "PII_GSTIN",
        "PII_IFSC",
        "PII_UPI",
        "SECRET_TOKEN",
        "SECRET_PRIVATE_KEY",
        "CONFIDENTIAL_MARKER",
        "SOURCE_CODE_CONTEXT",
        "CUSTOM_PROTECTED_TERM",
        "BULK_CONTACT_LIST"
      ]
    },
    "severity": {
      "enum": [
        "LOW",
        "MEDIUM",
        "HIGH",
        "CRITICAL"
      ]
    }
  }
}
