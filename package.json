{
  "name": "shadowshield",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/contracts",
    "packages/engine"
  ],
  "scripts": {
    "contracts:check": "node packages/contracts/scripts/generate-types.mjs --check && node packages/contracts/scripts/validate-contracts.mjs && node packages/contracts/scripts/generate-python-types.mjs --check",
    "contracts:generate": "node packages/contracts/scripts/generate-types.mjs && node packages/contracts/scripts/generate-python-types.mjs",
    "contracts:python:generate": "node packages/contracts/scripts/generate-python-types.mjs",
    "contracts:python:check": "node packages/contracts/scripts/generate-python-types.mjs --check",
    "build:extension": "tsc -p apps/extension/tsconfig.json && tsc -p apps/extension/tsconfig.background.json && node apps/extension/scripts/build-worker.mjs && node apps/extension/scripts/copy-static.mjs",
    "package:extension": "npm run build:extension && python apps/extension/scripts/package.py",
    "check:extension": "node apps/extension/scripts/validate-manifest.mjs",
    "test:extension": "npm run build:extension && node --test apps/extension/tests/*.test.mjs",
    "test:extension:browser": "npm run build:extension && playwright test -c apps/extension/playwright.config.mjs",
    "test:extension:package": "npm run package:extension && node apps/extension/scripts/test-packaged-extension.mjs",
    "build:dashboard": "npm --prefix apps/dashboard run build",
    "test:dashboard": "npm --prefix apps/dashboard test",
    "test:e2e": "npm run test:extension:browser && node tests/e2e/run.mjs",
    "dev:sandbox": "node apps/sandbox/server.mjs",
    "build:engine": "tsc -p packages/engine/tsconfig.json",
    "test:engine": "npm run build:engine && node --test packages/engine/tests/*.test.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "esbuild": "0.28.2",
    "json-schema-to-typescript": "^15.0.4",
    "typescript": "^5.7.3"
  }
}

